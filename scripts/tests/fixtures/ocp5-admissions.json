      },
      "name": "submariner-fbc-stage",
      "namespace": "rhtap-releng-tenant"
    },
    "spec": {
      "applications": [
        "submariner-fbc-5-0",
        "submariner-fbc-4-14",
        "submariner-fbc-4-15",
        "submariner-fbc-4-16",
        "submariner-fbc-4-17",
        "submariner-fbc-4-18",
        "submariner-fbc-4-19",
        "submariner-fbc-4-20",
        "submariner-fbc-4-21",
        "submariner-fbc-4-22"
      ],
      "origin": "submariner-tenant",
      "policy": "fbc-stage",
      "data": {
        "releaseNotes": {
          "product_id": [
            609
          ],
          "product_name": "Red Hat Advanced Cluster Management for Kubernetes",
          "product_version": "fbc"
        },
        "fbc": {
