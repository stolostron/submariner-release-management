          "buildTimeoutSeconds": 3000,
          "allowedPackages": [
            "submariner"
          ]
        },
        "intention": "staging"
      },
      "pipeline": {
        "pipelineRef": {
          "resolver": "git",
          "params": [
            {
              "name": "url",
              "value": "https://github.com/konflux-ci/release-service-catalog.git"
            },
            {
              "name": "revision",
              "value": "production"
            },
            {
              "name": "pathInRepo",
              "value": "pipelines/managed/fbc-release/fbc-release.yaml"
            }
          ]
        },
        "serviceAccountName": "release-index-image-staging",
        "timeouts": {
          "pipeline": "1h0m0s",
          "tasks": "1h0m0s"
        }
      }
    }
  },
